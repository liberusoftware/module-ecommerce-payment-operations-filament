{
    "name": "liberusoftware/ecommerce-payment-operations-filament",
    "description": "Filament administration for payment operations: a ledger you can read, three movements you can make, and a reconciliation queue nobody was reading. No status field, no form over a payment, no instrument and no secret on any surface.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-payment-operations"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0",
        "liberusoftware/module-manager": "^1.4",
        "liberusoftware/ecommerce-payment-operations": "^0.1"
    },
    "require-dev": {
        "liberusoftware/ecommerce-payment-operations": "^0.1",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\PaymentOperations\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\PaymentOperations\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-payment-operations-filament"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
